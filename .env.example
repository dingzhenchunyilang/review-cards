# 复制成 .env 再改成你自己的值。.env 不要提交到仓库。
#   cp .env.example .env
#
# ─────────────────────────── 必填 ───────────────────────────
# 访问用户名 / 密码。两个都填才会开启登录（HTTP Basic Auth）。
# 留空 = 不鉴权 —— 公网部署时千万不要留空。
APP_USER=ethan
APP_PASSWORD=change-me-to-something-long

# ─────────────────────────── 可选 ───────────────────────────
# 对外监听地址。默认 0.0.0.0:8000，即 http://服务器IP:8000 直接可访问。
# 启用 Caddy(HTTPS) 时改成 127.0.0.1:8000 —— 这样只有 Caddy 连得到 app，
# 8000 端口不再对外暴露。
APP_BIND=0.0.0.0:8000

# 站点域名。只有走 Caddy 申请 HTTPS 证书时才需要，且必须已解析到这台服务器。
# 没有域名就保持注释状态（默认的 HTTP 直连路径用不到它）。
# APP_DOMAIN=cards.example.com
